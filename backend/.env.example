PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50
YTDLP_TIMEOUT_MS=30000
# Max yt-dlp strategies to run in parallel during Phase 2 fallback.
# Each process uses ~50-100MB RAM. Default 2 is safe for Railway free tier (512MB).
YTDLP_MAX_PARALLEL_STRATEGIES=2
DATABASE_PATH=../../database.db
